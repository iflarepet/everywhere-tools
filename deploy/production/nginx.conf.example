# Replace tools.example.com with the intended hostname.
# Bootstrap HTTP configuration: enable HTTPS before sharing room links.
server {
    listen 80;
    listen [::]:80;
    server_name tools.example.com;
    client_max_body_size 1m;

    # Codes are access credentials: do not record URLs in access logs.
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Shared notes and chat use Server-Sent Events, not WebSockets.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
