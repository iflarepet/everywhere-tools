[Unit]
Description=Everywhere Tools
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/everywhere-tools/current
EnvironmentFile=/var/www/everywhere-tools/shared/.env.production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/everywhere-tools/shared/data

[Install]
WantedBy=multi-user.target
